datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Contact {
  id                  String        @id @default(cuid())
  phone               String        @unique
  jid                 String        @unique
  lid                 String?       @unique
  name                String?
  pushName            String?
  profilePicUrl       String?
  isWAUser            Boolean       @default(true)
  tags                String?       // comma-separated tags e.g. "Customer,Lead"
  notes               String?       // legacy single note (migrated/compatible with ContactNote)
  storeName           String?       // Nama Toko
  businessCategory    String?       // Kategori Bisnis (e.g. Kuliner, Fashion)
  email               String?       // Email Merchant
  accountCreatedAt    String?       // Tanggal Pembuatan Akun di Lapaq
  address             String?       // Alamat Toko / Kota
  lapaqStoreSlug      String?       // Slug toko di Lapaq (e.g. "warung-kopi-mantap")
  onboardingStage     String?       // "DRAFT" | "NO_CATEGORY" | "NO_PRODUCT" | "ACTIVE" | "UNKNOWN"
  productCount        Int?          // Cache jumlah produk terakhir yang diketahui
  installedAddOnsJson String?       // Cache ringkasan add-on aktif non-rahasia
  lastLapaqSyncAt     DateTime?     // Waktu sinkronisasi status toko terakhir
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  chats               Chat[]
  messages            Message[]
  contactNotes        ContactNote[]
  merchantMemory      MerchantMemory?
  supportIssues       SupportIssue[]

  @@index([phone])
  @@index([lid])
  @@index([storeName])
  @@index([businessCategory])
  @@index([lapaqStoreSlug])
  @@index([onboardingStage])
}

model ContactNote {
  id         String   @id @default(cuid())
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([contactId, createdAt])
}

model Chat {
  id               String         @id // jid e.g. "628123456789@c.us" or "...@lid"
  name             String?
  isGroup          Boolean        @default(false)
  unreadCount      Int            @default(0)
  lastMessage      String?
  lastMessageAt    DateTime?
  lastInboundAt    DateTime?
  lastAwaySentAt   DateTime?
  status           String         @default("OPEN") // "OPEN" | "FOLLOW_UP" | "RESOLVED"
  agentMode        String         @default("AI_ACTIVE") // "AI_ACTIVE" | "STEP_BY_STEP" | "WAITING_TECH" | "HUMAN_TAKEOVER"
  activeGuideState String?        // JSON posisi langkah panduan aktif
  campaignContext  String?        // JSON konteks kampanye sapaan proaktif
  aiTurnCountToday Int            @default(0)
  aiTurnResetDate  String?        // YYYY-MM-DD WIB terakhir counter di-reset
  assigneeId       String?
  assignee         User?          @relation("AssignedChats", fields: [assigneeId], references: [id], onDelete: SetNull)
  reminderAt       DateTime?
  reminderNote     String?
  contactId        String?
  contact          Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  messages         Message[]
  supportIssues    SupportIssue[]

  @@index([lastMessageAt])
  @@index([updatedAt])
  @@index([status])
  @@index([agentMode])
  @@index([assigneeId])
  @@index([reminderAt])
}

model Message {
  id            String   @id // WA message id
  chatId        String
  chat          Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  fromMe        Boolean  @default(false)
  isAiGenerated Boolean  @default(false)
  body          String?
  mediaType     String?  // "text" | "image" | "document" | "audio" | "video"
  mediaUrl      String?
  fileName      String?
  ackStatus     Int      @default(0) // 0: Pending, 1: Sent, 2: Delivered, 3: Read
  quotedMsgId   String?
  quotedBody    String?  // Snippet of quoted message
  quotedSender  String?  // Sender name of quoted message (e.g. "Anda" or "Rizky")
  senderName    String?  // Sender display name (especially useful for group chats)
  timestamp     DateTime @default(now())

  @@index([chatId, timestamp])
  @@index([fromMe, timestamp])
}

model User {
  id             String         @id @default(cuid())
  username       String         @unique
  password       String
  name           String
  role           String         @default("ADMIN") // "ADMIN" or "OPERATOR"
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignedChats  Chat[]         @relation("AssignedChats")
  resolvedIssues SupportIssue[] @relation("ResolvedIssues")
}

model MessageTemplate {
  id          String   @id @default(cuid())
  shortcut    String   @unique // e.g. "/salam"
  title       String
  category    String   @default("Umum") // "Onboarding" | "Follow Up" | "Promo" | "CS" | "Umum"
  body        String
  mediaUrl    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model BroadcastCampaign {
  id               String               @id @default(cuid())
  name             String
  templateId       String?
  messageBody      String
  mediaUrl         String?
  delayMinSec      Int                  @default(10)
  delayMaxSec      Int                  @default(20)
  status           String               @default("DRAFT") // "DRAFT" | "RUNNING" | "PAUSED" | "COMPLETED" | "CANCELLED"
  enableAiFollowup Boolean              @default(false)
  campaignGoal     String?              // Konteks tujuan kampanye bagi AI saat penerima membalas
  totalCount       Int                  @default(0)
  sentCount        Int                  @default(0)
  failedCount      Int                  @default(0)
  createdById      String?
  createdByName    String?
  createdAt        DateTime             @default(now())
  completedAt      DateTime?

  recipients       BroadcastRecipient[]

  @@index([status])
  @@index([createdAt])
}

model BroadcastRecipient {
  id               String            @id @default(cuid())
  campaignId       String
  campaign         BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone            String
  jid              String
  contactId        String?
  storeName        String?
  contactName      String?
  businessCategory String?
  status           String            @default("QUEUED") // "QUEUED" | "SENT" | "FAILED"
  error            String?
  sentAt           DateTime?

  @@index([campaignId, status])
}

model KnowledgeChunk {
  id             String                      @id @default(cuid())
  sourceType     String                      // "TUTORIAL" | "DEMO_UI" | "REPO_BUNDLE" | "RELEASE_NOTE" | "PUBLIC_FAQ" | "LOCKED_POLICY" | "QUICK_NOTE"
  sourceKey      String                      @unique
  title          String
  category       String                      @default("Umum")
  content        String
  structuredMeta String?                     // JSON metadata (steps[], requires[], helpUrl, featureStatus)
  contentHash    String                      // SHA-256 hash untuk deteksi perubahan konten
  isActive       Boolean                     @default(true)
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([sourceType, isActive])
  @@index([category])
}

model MerchantMemory {
  id                  String   @id @default(cuid())
  contactId           String   @unique
  contact             Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  summary             String
  factsJson           String?
  lastSummarizedMsgId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SupportIssue {
  id                 String      @id @default(cuid())
  code               String      @unique // e.g. "ISS-0001"
  chatId             String
  chat               Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  category           String      @default("TECHNICAL_BUG") // "TECHNICAL_BUG" | "UPLOAD_SAVE_ERROR" | "PAYMENT_WALLET" | "REFUND_REQUEST" | "OTHER"
  title              String
  symptomSummary     String
  stepsTried         String?
  screenshotUrls     String?     // JSON array string URL di /uploads/...
  status             String      @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED"
  techResolutionNote String?
  publicUserSolution String?
  isReusableCase     Boolean     @default(false)
  followupConsent    Boolean     @default(false)
  followupSentAt     DateTime?
  resolvedById       String?
  resolvedBy         User?       @relation("ResolvedIssues", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  caseMemory         CaseMemory?

  @@index([status, createdAt])
  @@index([chatId])
  @@index([contactId])
  @@index([category])
}

model CaseMemory {
  id               String                      @id @default(cuid())
  issueId          String?                     @unique
  issue            SupportIssue?               @relation(fields: [issueId], references: [id], onDelete: SetNull)
  title            String
  symptomPattern   String
  rootCause        String
  verifiedSolution String
  applicability    String                      @default("PERMANENT") // "PERMANENT" | "TEMPORARY_INCIDENT"
  isActive         Boolean                     @default(true)
  hitCount         Int                         @default(0)
  embedding        Unsupported("vector(768)")?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([isActive, applicability])
}

model AppSetting {
  key       String   @id
  value     String   // JSON serialized payload
  updatedAt DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid())
  type      String   // "MESSAGE_SENT" | "MESSAGE_RECEIVED" | "MEDIA_UPLOAD" | "SESSION_CHANGE" | "AUTH" | "BROADCAST" | "AGENT" | "SECURITY_WARNING" | "ERROR"
  status    String   // "SUCCESS" | "ERROR" | "WARNING"
  message   String
  details   String?
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([type])
}
